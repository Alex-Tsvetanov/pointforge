# latexmk writes into docs/build. Everything there is regenerable from source,
# so nothing from it is committed. When the report is finished and a specific
# PDF has to be preserved, add an exception for that file, not for the folder.
docs/build/
docs/generated/

# --- Measurement output -----------------------------------------------------
# Raw timing runs are regenerable and machine specific. Only the aggregated
# tables that the report cites are committed.
results/raw/

# --- Datasets ---------------------------------------------------------------
# Large inputs are fetched, not stored.
data/*
!data/.gitkeep
!data/README.md

